menuconfig IEC60730B
    bool "Safety IEC60730B librray support"
    help
      This option enables the Safety IEC60730B test library

if IEC60730B

    config IEC60730B_TEST_CPU_REG
        bool "Enables IEC60730B CPU registers test routines"
        default y

    config IEC60730B_TEST_CPU_REG_FPU
        bool "Enables IEC60730B FPU registers test routines"
        default y
        depends on IEC60730B_TEST_CPU_REG && CPU_HAS_FPU
        select FPU

    config IEC60730B_TEST_CPU_REG_DSP
        bool "Enables IEC60730B DSP registers test routines"
        default y
        depends on IEC60730B_TEST_CPU_REG && ARMV8_M_DSP

    config IEC60730B_TEST_CPU_REG_TZ
        bool "Enables IEC60730B Trust Zone registers test routines"
        default y
        depends on IEC60730B_TEST_CPU_REG && ARM_TRUSTZONE_M

    config IEC60730B_TEST_PC
        bool "Enables IEC60730B Program Counter test routine"
        default y
        help
          This option enables Program Counter test routine for IEC60730B safety library.
          The PC test verifies the proper execution flow and detects program counter
          corruption or unexpected jumps in code execution.

    config IEC60730B_TEST_RAM
        bool "Enables IEC60730B RAM test routine"
        default y
        help
          This option enables RAM test routine for IEC60730B safety library.
          The RAM test verifies the integrity of system memory using various
          test patterns and algorithms to detect memory faults.

endif # IEC60730B
